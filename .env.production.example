# Copy this file to .env.production and replace every placeholder locally.
# .env.production is ignored by Git and must never be committed.

POSTGRES_USER=replace-with-production-database-user
POSTGRES_PASSWORD=replace-with-production-database-password
RABBITMQ_USER=replace-with-production-rabbitmq-user
RABBITMQ_PASSWORD=replace-with-production-rabbitmq-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
PROMOTE_FIRST_ADMIN=false
WORKER_CONCURRENCY=1
WORKER_MAX_CONCURRENCY=2
WORKER_REPLICAS=3
RUNNER_TOKEN=replace-with-a-random-runner-token
DOCKER_SOCKET_GID=replace-with-docker-socket-group-id
RUNNER_MAX_CONCURRENCY=4
RUNNER_INSTANCE_ID=oj-runner
RUNNER_DOCKER_PIDS_LIMIT=64
RUNNER_DOCKER_PYTHON_IMAGE=practice-sandbox-python:local
RUNNER_DOCKER_JAVASCRIPT_IMAGE=practice-sandbox-javascript:local
RUNNER_DOCKER_C_IMAGE=practice-sandbox-c:local
RUNNER_DOCKER_CPP_IMAGE=practice-sandbox-cpp17:local
RUNNER_DOCKER_JAVA_IMAGE=practice-sandbox-java:local
