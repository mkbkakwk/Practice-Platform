# Copy this file to .env.production and replace every placeholder locally.
# .env.production is ignored by Git and must never be committed.

POSTGRES_USER=replace-with-production-database-user
POSTGRES_PASSWORD=replace-with-production-database-password
RABBITMQ_USER=replace-with-production-rabbitmq-user
RABBITMQ_PASSWORD=replace-with-production-rabbitmq-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
PROMOTE_FIRST_ADMIN=false
WORKER_CONCURRENCY=1
WORKER_MAX_CONCURRENCY=2
