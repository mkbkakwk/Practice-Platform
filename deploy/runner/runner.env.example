RUNNER_TOKEN=replace-with-a-dedicated-secret-outside-git
RUNNER_SANDBOX_MODE=linux
RUNNER_NSJAIL_PATH=/usr/bin/nsjail
RUNNER_SANDBOX_ROOTFS=/srv/oj-sandbox-runner/rootfs
RUNNER_WORKSPACE_ROOT=/run/oj-sandbox-runner/jobs
RUNNER_SECCOMP_POLICY=/etc/oj-sandbox-runner/nsjail-seccomp.policy
RUNNER_CGROUP_V2_MOUNT=/sys/fs/cgroup/system.slice/oj-sandbox-runner.service
RUNNER_STUDENT_UID=65534
RUNNER_STUDENT_GID=65534
RUNNER_PIDS_MAX=32
RUNNER_CPU_MS_PER_SECOND=1000
RUNNER_MAX_CONCURRENT_JOBS=2
