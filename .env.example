# OJ 环境变量配置示例
# 复制为 .env 并按需修改（不修改也能直接用默认值一键启动）

# 前端对外端口（访问 http://localhost:8080）
PORT=8080

# 数据库
POSTGRES_USER=oj
POSTGRES_PASSWORD=oj
POSTGRES_DB=oj

# 后端安全配置（生产环境务必修改 JWT_SECRET）
JWT_SECRET=please-change-this-secret-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*

# 是否将第一个注册用户提升为管理员（1=是，0=否）
PROMOTE_FIRST_ADMIN=1
