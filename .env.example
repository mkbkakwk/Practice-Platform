# OJ 环境变量配置示例
# 复制为 .env 并按需修改（不修改也能直接用默认值一键启动）

# 前端对外端口（Production 默认访问 http://localhost:3000）
PORT=3000

# 后端对外端口（一般不用改）
BACKEND_PORT=4000

# 数据库
POSTGRES_USER=oj
POSTGRES_PASSWORD=oj
POSTGRES_DB=oj

# 消息队列（评测任务调度）
RABBITMQ_USER=oj
RABBITMQ_PASSWORD=oj

# 评测 Worker（默认 3 个竞争消费者）
# WORKER_REPLICAS 控制 Worker 容器数量（水平扩展，扛并发）
# 例如 300 人同时提交设为 3-5
WORKER_REPLICAS=3
WORKER_CONCURRENCY=1
WORKER_MAX_CONCURRENCY=2

# Docker Sandbox Runner。正式 Worker 固定使用 remote，失败不会回退本地执行。
# RUNNER_TOKEN 必须替换为随机值；Linux 可用 `stat -c %g /var/run/docker.sock`
# 取得 socket GID，Docker Desktop 通常为 0。
RUNNER_TOKEN=replace-with-a-random-runner-token
DOCKER_SOCKET_GID=0
RUNNER_MAX_CONCURRENCY=4
RUNNER_INSTANCE_ID=oj-runner
RUNNER_DOCKER_PIDS_LIMIT=64
RUNNER_DOCKER_NANO_CPUS=1000000000
RUNNER_DOCKER_WORKSPACE_BYTES=67108864
RUNNER_DOCKER_TMP_BYTES=33554432

JUDGE_COMPILE_TIMEOUT_MS=10000
JUDGE_OUTPUT_LIMIT_BYTES=16777216
JUDGE_MAX_SOURCE_BYTES=1048576
JUDGE_MAX_STDIN_BYTES=1048576
RUNNER_CONNECT_TIMEOUT_MS=1000
RUNNER_READ_TIMEOUT_MS=15000
RUNNER_MAX_REQUEST_BYTES=4194304
RUNNER_MAX_RESPONSE_BYTES=33554432

# 后端安全配置（生产环境务必修改 JWT_SECRET）
JWT_SECRET=please-change-this-secret-in-production-must-be-at-least-32-chars
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*

# 仅用于受控初始化：是否将第一个注册用户提升为管理员（1=是，0=否）
# 生产环境保持关闭；需要时显式开启，创建首个管理员后立即关闭。
PROMOTE_FIRST_ADMIN=0
