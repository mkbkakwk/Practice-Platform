<configuration>
  <springProperty scope="context" name="gitSha" source="oj.build.git-sha" defaultValue="unknown"/>
  <springProfile name="staging,production">
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
      <encoder class="net.logstash.logback.encoder.LogstashEncoder">
        <customFields>{"service":"backend","gitSha":"${gitSha}"}</customFields>
      </encoder>
    </appender>
  </springProfile>
  <springProfile name="!staging &amp; !production">
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
      <encoder><pattern>%d{HH:mm:ss.SSS} %-5level service=backend requestId=%X{requestId} event=%logger{36} - %msg%n</pattern></encoder>
    </appender>
  </springProfile>
  <root level="INFO"><appender-ref ref="CONSOLE"/></root>
</configuration>
