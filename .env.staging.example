# Copy to .env.staging with scripts/staging-init-env.sh.
# This example contains placeholders only and must never be used as-is.

STAGING_FRONTEND_PORT=18080

STAGING_POSTGRES_DB=practice_platform_staging
STAGING_POSTGRES_USER=staging_user
STAGING_POSTGRES_PASSWORD=change-me-staging-postgres-password

STAGING_RABBITMQ_USER=staging_user
STAGING_RABBITMQ_PASSWORD=change-me-staging-rabbitmq-password

STAGING_JWT_SECRET=replace-with-random-staging-secret-at-least-32-characters
STAGING_JWT_EXPIRES_IN=1d
STAGING_PROMOTE_FIRST_ADMIN=false

STAGING_WORKER_CONCURRENCY=1
STAGING_WORKER_MAX_CONCURRENCY=1

STAGING_SMOKE_USERNAME_PREFIX=stgsmoke
STAGING_SMOKE_PASSWORD=change-me-staging-smoke-password
# Short SHA remains only a human-friendly image tag / Staging badge.
STAGING_GIT_SHA=replace-with-current-short-git-sha
# Full SHA and UTC build time are immutable release evidence injected into the
# application and OCI image labels by the Staging build path.
STAGING_FULL_GIT_SHA=replace-with-current-full-git-sha
STAGING_BUILD_TIME=replace-with-utc-build-time
